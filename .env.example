# .env.example — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores.
# init.sh verificará que TODAS estas claves estén presentes en `.env`.
# NUNCA subas el `.env` real al repositorio.

# ---------- Backend ----------
# PORT=8001
# DB_PATH=app/backend/data/crecetube.db
# LLM_API_KEY=            (opcional: clave de OpenRouter para los generadores IA)
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/free
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ---------- Frontend (Vite solo expone las VITE_*) ----------
# VITE_BACKEND_URL=       (vacío en dev: Vite hace proxy de /api al backend)
