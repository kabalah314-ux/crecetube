# .env.example — Plantilla de variables de entorno
# Copia este archivo como `.env` y rellena los valores.
# init.sh verificará que TODAS estas claves estén presentes en `.env`.
# NUNCA subas el `.env` real al repositorio.

# ---------- Backend ----------
# PORT=8001

# Base de datos (libSQL / Turso).
#  - LOCAL: deja DB_URL vacío y la app usa un fichero SQLite (file:) en DB_PATH.
#  - PRODUCCIÓN (Vercel): define DB_URL=libsql://<tu-db>.turso.io y DB_AUTH_TOKEN.
# DB_PATH=app/backend/data/crecetube.db
# DB_URL=
# DB_AUTH_TOKEN=

# IA (opcional): clave de OpenRouter para los generadores.
# LLM_API_KEY=
# LLM_PROVIDER=openrouter
# LLM_MODEL=openrouter/free
# LLM_BASE_URL=https://openrouter.ai/api/v1

# ---------- Frontend (Vite solo expone las VITE_*) ----------
# VITE_BACKEND_URL=       (vacío: mismo origen; en dev Vite hace proxy de /api al backend)
